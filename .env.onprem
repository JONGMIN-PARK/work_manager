# ============================================================
# Work Manager 온프레미스 환경 설정
# 이 파일을 .env로 복사한 후 값을 변경하세요.
# ============================================================

# ─── 데이터베이스 ───
DB_NAME=workmanager
DB_USER=postgres
DB_PASSWORD=changeme-strong-password
DB_PORT=5432

# ─── JWT 시크릿 (반드시 변경!) ───
# openssl rand -hex 32 로 생성 추천
JWT_SECRET=change-this-to-random-256bit-hex-string
JWT_REFRESH_SECRET=change-this-to-another-random-256bit-hex-string

# ─── 서버 설정 ───
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:8080
APP_PORT=8080

# ─── 이메일 (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── 텔레그램 봇 (선택) ───
TELEGRAM_BOT_TOKEN=

# ─── AI (선택) ───
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 라이선스 키 (엔터프라이즈) ───
LICENSE_KEY=
